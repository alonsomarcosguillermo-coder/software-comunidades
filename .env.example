DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=comunidades
POSTGRES_USER=comunidades
POSTGRES_PASSWORD=comunidades
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
